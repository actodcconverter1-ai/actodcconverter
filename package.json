{
  "name": "ac-to-dc-converter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "audit:site": "node scripts/audit-site.mjs",
    "verify": "npm run lint && npm run check && npm test && npm run audit:content && npm run build && npm run audit:site && npm run audit:graph",
    "preview:worker": "wrangler dev",
    "deploy:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "node scripts/check-release.mjs && npm run verify && wrangler deploy",
    "admin": "node --experimental-strip-types scripts/admin-server.mjs",
    "audit:content": "node --experimental-strip-types scripts/audit-content.mjs",
    "audit:graph": "node scripts/audit-topic-graph.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.6",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.4.5",
    "dompurify": "3.4.17",
    "jose": "6.2.15",
    "marked": "18.1.3",
    "tailwindcss": "4.3.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "wrangler": "4.156.2"
  }
}
