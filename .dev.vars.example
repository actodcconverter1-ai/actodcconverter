# Copy to .dev.vars only for local Wrangler tests against the intended account.
# Local file editing with npm run admin needs none of these values.
ACCESS_TEAM_DOMAIN="your-team.cloudflareaccess.com"
ACCESS_AUD="replace-with-Access-application-audience"
ADMIN_EMAILS=""
GITHUB_OWNER=""
GITHUB_REPO=""
GITHUB_BRANCH="main"
# Production token: set with `npx wrangler secret put GITHUB_TOKEN`.
# Never commit a real token or put one into editorial.json.
