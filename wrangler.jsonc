{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ac-to-dc-converter",
  "account_id": "0863917d131e2a06192ec0ce3748952a",
  "workers_dev": true,
  "preview_urls": false,
  "main": "worker/index.ts",
  "vars": {
    "GITHUB_OWNER": "actodcconverter1-ai",
    "GITHUB_REPO": "actodcconverter",
    "GITHUB_BRANCH": "main"
  },
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/admin/*", "/admin", "/admin/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
