---
import Base from '../../layouts/Base.astro';
import ArticleCards from '../../components/ArticleCards.astro';
import { posts } from '../../lib/posts';
import {categoryGuides} from '../../config/category-guides';
import {categoryLearning,categoryReading} from '../../config/category-learning';
export async function getStaticPaths() { const entries = await posts(); return [...new Set(entries.flatMap(entry => entry.data.categories))].map(category => ({ params: { category }, props: { category, entries: entries.filter(entry => entry.data.categories.includes(category)) } })); }
const { category, entries } = Astro.props;
const name = category.replaceAll('-', ' ');
const guide=categoryGuides[category];
const learning=categoryLearning[category];
const reading=categoryReading[category];
---
<Base breadcrumbTitle={name} title={guide?.title??`${name[0].toUpperCase()}${name.slice(1)} Guides`} titleIsComplete={!!guide} description={guide?.description??`Read ${entries.length} practical guides about ${name}, with explanations, examples, and links to primary references.`}>
 <section class="shell page-intro"><span class="eyebrow">EXPLORE A TOPIC</span><h1 class:list={{capitalize:!guide}}>{guide?.title??name}</h1><p>Explanations and examples to help you understand rectifier output. Connect this topic with the <a href="/">AC to DC converter hub</a> and its circuit overview.</p>
 {guide&&<p>{guide.intro}</p>}{learning&&<p>{learning[0]}</p>}
 {guide&&<section class="prose narrow"><h2>Start with these guides</h2><ol>{guide.steps.map(step=><li><a href={step.href}>{step.title}</a> — {step.description}</li>)}</ol></section>}
 {!guide&&reading&&<section class="prose narrow"><h2>Start with these guides</h2><ol>{reading.map(step=><li><a href={step.href}>{step.title}</a> — {step.description}</li>)}</ol></section>}
 {learning&&<section class="prose narrow" data-category-learning><h2>How to use this reading path</h2>{learning.slice(1).map(paragraph=><p>{paragraph}</p>)}</section>}
 <ArticleCards entries={entries} headingLevel={2} /></section>
</Base>
