---
import '../../styles/admin.css';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex, nofollow"/><title>Create Password Verifier | AC to DC Converter</title><meta name="description" content="Generate an owner-controlled password verifier locally in your browser."/><link rel="icon" href="/images/icons/favicon.svg"/></head><body class="login-page"><main class="login-card"><a class="login-brand" href="/">∿ AC/DC Studio</a><p class="login-eyebrow">OWNER PASSWORD SETUP</p><h1>Your password stays yours.</h1><p>This page creates a salted verification hash locally. Your password is not sent, saved, or added to any project file.</p><form id="setup-password"><div class="field"><label for="new-password">Choose a unique password · at least 20 characters</label><input id="new-password" type="password" autocomplete="new-password" minlength="20" maxlength="256" required/></div><div class="field"><label for="confirm-password">Confirm password</label><input id="confirm-password" type="password" autocomplete="new-password" minlength="20" maxlength="256" required/></div><button class="primary" type="submit" id="create-verifier">Generate verification hash</button><p id="setup-message" role="status"></p></form><section id="verifier-result" hidden><div class="field"><label for="password-verifier">Verification hash · this is not your password</label><textarea id="password-verifier" rows="5" readonly></textarea></div><button id="copy-verifier">Copy verification hash</button><p style="margin-top:15px;font-size:12px">In Cloudflare, open this Worker → Settings → Variables and Secrets. Add a <strong>Secret</strong> named <strong>ADMIN_PASSWORD_HASH</strong> and paste the verification hash there. Keep your original password in your password manager. Do not paste either value into chat.</p></section><a class="login-back" href="/admin/login/">Go to dashboard login →</a></main><script>
const form=document.getElementById('setup-password') as HTMLFormElement;
const message=document.getElementById('setup-message')!;
const button=document.getElementById('create-verifier') as HTMLButtonElement;
const base64url=(bytes:Uint8Array)=>btoa(String.fromCharCode(...bytes)).replaceAll('+','-').replaceAll('/','_').replaceAll('=','');
form.addEventListener('submit',async event=>{event.preventDefault();if(!form.reportValidity())return;const first=document.getElementById('new-password') as HTMLInputElement;const confirm=document.getElementById('confirm-password') as HTMLInputElement;if(first.value!==confirm.value){message.textContent='The passwords do not match.';return;}button.disabled=true;message.textContent='Creating your salted verifier locally…';try{const salt=crypto.getRandomValues(new Uint8Array(16));const material=await crypto.subtle.importKey('raw',new TextEncoder().encode(first.value),'PBKDF2',false,['deriveBits']);const result=await crypto.subtle.deriveBits({name:'PBKDF2',hash:'SHA-256',salt,iterations:100000},material,256);(document.getElementById('password-verifier') as HTMLTextAreaElement).value=`pbkdf2-sha256:100000:${base64url(salt)}:${base64url(new Uint8Array(result))}`;first.value='';confirm.value='';document.getElementById('verifier-result')!.hidden=false;message.textContent='Verification hash created. Your original password was cleared from this page.';}catch{message.textContent='Could not generate a verifier. Use a current browser over HTTPS.';}finally{button.disabled=false;}});
document.getElementById('copy-verifier')!.addEventListener('click',async()=>{try{await navigator.clipboard.writeText((document.getElementById('password-verifier') as HTMLTextAreaElement).value);message.textContent='Verification hash copied. Paste it only into the encrypted Worker secret.';}catch{message.textContent='Select the verification hash and copy it manually.';}});
</script></body></html>
