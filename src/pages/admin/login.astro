---
import '../../styles/admin.css';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex, nofollow"/><title>Dashboard Login | AC to DC Converter</title><meta name="description" content="Private editorial dashboard sign-in."/><link rel="icon" href="/images/icons/favicon.svg"/></head><body class="login-page"><main class="login-card"><a class="login-brand" href="/">∿ AC/DC Studio</a><p class="login-eyebrow">YOUR EDITORIAL WORKSPACE</p><h1>Welcome back.</h1><p>Sign in to manage your posts, media, and website.</p><form id="login-form"><div class="field"><label for="login-email">Email address</label><input id="login-email" name="email" type="email" autocomplete="username" required maxlength="254"/></div><div class="field"><label for="login-password">Password</label><input id="login-password" name="password" type="password" autocomplete="current-password" required maxlength="256"/></div><button class="primary" id="login-button" type="submit">Sign in →</button><p id="login-message" role="status" aria-live="polite"></p></form><noscript><p>Enable JavaScript to sign in.</p></noscript><a class="login-back" href="/">← Back to the calculator</a><a class="login-back" href="/admin/password-setup/">Owner password setup →</a><p class="login-footnote">Private access · Your login details are never published.</p></main><script>
const form=document.getElementById('login-form') as HTMLFormElement;
const button=document.getElementById('login-button') as HTMLButtonElement;
const message=document.getElementById('login-message')!;
async function status(){try{const response=await fetch('/api/admin/auth/status',{cache:'no-store'});const state=await response.json();if(state.authenticated)location.replace('/admin/');else if(!state.ready){message.textContent='The owner is finishing login setup. Please try again shortly.';button.disabled=true;}}catch{message.textContent='Could not reach the login service. Please refresh.';}}
form.addEventListener('submit',async event=>{event.preventDefault();if(!form.reportValidity())return;button.disabled=true;message.textContent='Signing in…';try{const email=(form.elements.namedItem('email') as HTMLInputElement).value;const password=(form.elements.namedItem('password') as HTMLInputElement).value;const response=await fetch('/api/admin/auth/login',{method:'POST',headers:{'Content-Type':'application/json','X-Admin-Request':'1'},body:JSON.stringify({email,password})});const result=await response.json();if(!response.ok)throw new Error(result.error??'Sign-in failed.');(form.elements.namedItem('password') as HTMLInputElement).value='';location.replace('/admin/');}catch(error){message.textContent=error instanceof Error?error.message:'Sign-in failed.';button.disabled=false;}});
status();
</script></body></html>
