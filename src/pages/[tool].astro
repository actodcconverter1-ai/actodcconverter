---
import {webApplication} from '../lib/structured-data';
import Base from '../layouts/Base.astro';
import Calculator from '../components/Calculator.astro';
export function getStaticPaths() { return [
  { params: { tool: 'full-wave-rectifier-calculator' }, props: { title: 'Full-wave rectifier calculator', mode: 'full-wave' as const, description: 'Calculate the average of an ideal unfiltered full-wave rectified sine wave.', formula: 'Vdc = 2√2 × Vrms ÷ π', example: '12 V RMS gives approximately 10.8038 V average and 16.9706 V peak. At 50 Hz AC, ripple frequency is 100 Hz.', context: 'Both half-cycles contribute positive output. The output returns to zero twice per AC cycle and remains pulsating. Its average is not its RMS value.' } },
  { params: { tool: 'half-wave-rectifier-calculator' }, props: { title: 'Half-wave rectifier calculator', mode: 'half-wave' as const, description: 'Calculate the complete-cycle average of an ideal unfiltered half-wave rectifier.', formula: 'Vdc = √2 × Vrms ÷ π', example: '12 V RMS gives approximately 5.4019 V average and 16.9706 V peak. At 50 Hz AC, ripple frequency is 50 Hz.', context: 'Only one half-cycle contributes output. Averaging over the full cycle, including the blocked half-cycle, gives half the ideal full-wave average. This is not a capacitor-filtered supply.' } },
]; }
const { title, mode, description, formula, example, context } = Astro.props;
---
<Base title={title} description={description} schema={[webApplication(Astro.url.pathname,title,description,[formula,example])]} ><div class="shell page-intro"><span class="eyebrow">IDEAL UNFILTERED MODEL</span><h1>{title}</h1><p class="spoke-intro">{description} Start with the <a href="/">AC to DC converter hub</a> to compare rectification, filtering and regulation before using this ideal model.</p><div id="calculator"><Calculator mode={mode} /></div><article class="prose narrow"><h2>The calculation</h2><div class="formula">{formula}</div><p>{context}</p><h2>Worked example</h2><p>{example}</p><h2>Scope</h2><p>Assumes sinusoidal single-phase AC, a resistive load, and ideal zero-loss diodes. No capacitor, transformer regulation, diode drop, or regulator is modeled. Inputs: 0–1,000 V RMS and 1–1,000 Hz.</p><p>The average comes from integrating the rectified sine over a full cycle. Compare rounded factors in <a href="https://www.hammfg.com/electronics/transformers/rectifier">Hammond's rectifier guide</a>.</p><p><a href="/ac-to-dc-calculator/">Try the filtered bridge estimate and read all assumptions →</a></p></article></div></Base>
