---
import Base from '../layouts/Base.astro';import ConverterWorkbench from '../components/ConverterWorkbench.astro';import EducationOverview from '../components/EducationOverview.astro';import ArticleCards from '../components/ArticleCards.astro';import{posts}from'../lib/posts';
const all=await posts();const preferred=['power-supply-stages-explained','ac-to-dc-formulas','choosing-ac-to-dc-power-supply','full-wave-bridge-rectifier-explained','linear-vs-switching-power-supplies','power-supply-vs-battery-charger-and-led-driver'];const articles=preferred.map(slug=>all.find(entry=>entry.data.slug===slug)).filter((entry):entry is NonNullable<typeof entry>=>!!entry);
---
<Base title="AC to DC Converter: Calculator, Circuits & Types" titleIsComplete description="Use the AC to DC converter calculator, compare rectifier types, read circuit diagrams, and understand filtering, regulation, ripple, losses and applications.">
 <section class="hub-hero shell"><div><p class="eyebrow">CALCULATE THE OUTPUT. UNDERSTAND THE CIRCUIT.</p><h1>AC to DC converter.<br/><em>Clarity at every stage.</em></h1><p>Calculate rectifier output, explore the circuits, and see how diodes, capacitors and regulators turn an AC waveform into useful DC power.</p><div class="hub-actions"><a class="button" href="#calculator">Use the calculator ↗</a><a class="text-action" href="#working-principle">Learn how conversion works ↓</a></div><div class="trust-strip"><span>Defined models</span><span>Source-linked guides</span><span>No signup needed</span></div></div><figure class="hero-wave"><svg viewBox="0 0 440 240" role="img" aria-label="AC input, rectified pulses and filtered DC shown as three different waveforms"><rect width="440" height="240" rx="18" fill="#eef5ff"/><g fill="#173759" font-family="Arial,sans-serif" font-size="17"><text x="25" y="38">AC input</text><text x="25" y="108">Rectified output</text><text x="25" y="181">Filtered DC</text></g><path d="M165 52C180 2 195 2 210 52S240 102 255 52S285 2 300 52S330 102 345 52S375 2 390 52" fill="none" stroke="#6c8db4" stroke-width="3"/><path d="M165 132Q188 65 210 132Q233 65 255 132Q278 65 300 132Q323 65 345 132Q368 65 390 132" fill="none" stroke="#1764c0" stroke-width="3"/><path d="M165 197L209 207L210 197L254 207L255 197L299 207L300 197L344 207L345 197L390 207" fill="none" stroke="#1764c0" stroke-width="3"/></svg><figcaption>Direction, ripple and regulation describe different parts of the conversion process.</figcaption></figure></section>
 <div class="shell"><ConverterWorkbench/></div><EducationOverview/>
 <section class="shell hub-guides"><p class="eyebrow">GO DEEPER, ONE QUESTION AT A TIME</p><div class="section-heading"><h2>AC to DC converter guides</h2><a href="/blog/">Browse every guide →</a></div><ArticleCards entries={articles}/></section>
</Base>
