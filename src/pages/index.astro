---
import Base from '../layouts/Base.astro';
import ConverterWorkbench from '../components/ConverterWorkbench.astro';
import BridgeExample from '../components/BridgeExample.astro';
import EducationOverview from '../components/EducationOverview.astro';
import ArticleCards from '../components/ArticleCards.astro';
import {posts} from '../lib/posts';
import {webApplication,techArticle,faqPage} from '../lib/structured-data';
import {homepageFaqs} from '../config/homepage-faq';
import ShareLinks from '../components/ShareLinks.astro';
import {homepageUpdated} from '../config/content-dates';
const guideTitle='AC to DC Converter Calculator: Voltage, Ripple & Circuits';
const guideUpdated=homepageUpdated;
const all = await posts();
const schema=[webApplication('/','AC to DC converter calculator','Calculate rectifier output, capacitor ripple and conditional regulator-stage power.',['Basic diode-drop rectification','Current or resistance-load filtering','Conditional regulator-stage analysis']),techArticle('/',guideTitle,'How rectification, filtering and regulation convert AC into DC, with circuit diagrams and output calculations.',{dateModified:guideUpdated,about:{'@type':'Thing',name:'AC to DC conversion'}}),faqPage('/',homepageFaqs)];
const preferred = ['ac-to-dc-formulas', 'ac-to-dc-calculator-worked-examples', 'full-wave-bridge-rectifier-explained', 'smoothing-capacitor-calculation', 'half-wave-vs-full-wave-rectifier', 'single-phase-vs-three-phase-rectifiers'];
const articles = preferred.map(slug => all.find(entry => entry.data.slug === slug)).filter((entry): entry is NonNullable<typeof entry> => !!entry);
---
<Base title={guideTitle} titleIsComplete schema={schema} description="Free AC to DC calculator: enter RMS voltage, diode drop, capacitor and load to estimate DC output and ripple. Includes circuits and a 12 V worked example.">
  <section class="hub-hero shell calculator-hero">
    <div>
      <p class="eyebrow">CALCULATOR · CIRCUITS · PRACTICAL GUIDES</p>
      <h1>AC to DC Converter: Calculator, Circuits and How It Works</h1><aside class="quick-answer home-answer"><strong>Quick answer</strong><p>Ideal unfiltered full-wave</p><code translate="no">Vdc(avg) ≈ 0.9 × Vrms</code><p>Filtered bridge: small ripple, constant-current load</p><code translate="no">Vdc(avg) ≈ 1.414 × Vrms − 2Vf − ΔVpp/2</code><p>A rectifier alone does not regulate the output.</p></aside>
      <p>Use the <a href="/ac-to-dc-calculator/">AC to DC converter calculator</a> below, or compare <a href="/blog/half-wave-vs-full-wave-rectifier/">half-wave and full-wave rectifier outputs</a>. The result depends on the circuit, diode drops, filtering and load.</p>
      <div class="trust-strip"><span>Runs on your device</span><span>Source-linked methods</span><span>No signup</span></div>
    </div>
    <ConverterWorkbench/>
    <p class="hero-definition">An <strong>AC to DC converter</strong> changes alternating current into direct current. A <a href="/blog/full-wave-bridge-rectifier-explained/">bridge rectifier</a> produces pulsating DC; a filter reduces ripple, and a suitable regulator can hold a target voltage within its operating limits.</p>
  </section>
  <div class="shell"><BridgeExample/></div>
  <EducationOverview/>
  <section class="shell guide-publication"><p class="byline">Guide updated <time datetime={guideUpdated}>19 November 2026</time> · <a href="/editorial/" rel="author">AC to DC Converter editorial</a></p><ShareLinks path="/" title={guideTitle}/></section>
  <section class="shell hub-guides"><p class="eyebrow">GO DEEPER, ONE QUESTION AT A TIME</p><div class="section-heading"><h2>AC to DC converter guides</h2><a href="/blog/">Browse every guide →</a></div><ArticleCards entries={articles}/></section>

</Base>
