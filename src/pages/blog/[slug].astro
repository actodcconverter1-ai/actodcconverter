---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import {blogPosting} from '../../lib/structured-data';
import { posts } from '../../lib/posts';
import { canonical } from '../../config/seo.config';
import ShareLinks from '../../components/ShareLinks.astro';
export async function getStaticPaths() { return (await posts()).map(entry => ({ params: { slug: entry.data.slug }, props: { entry } })); }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const briefFormulas:Record<string,string>={
 'full-wave-bridge-rectifier-explained':'Vavg = 2√2 Vrms/π; fripple = 2f',
 'half-wave-vs-full-wave-rectifier':'Vavg,half = Vpk/π; Vavg,full = 2Vpk/π',
 'single-phase-vs-three-phase-rectifiers':'fripple,1φ = 2f; fripple,3φ = 6f',
 'rectifier-average-vs-rms-output':'Vavg,full = 2Vpk/π; Vrms,full = Vpk/√2',
};
const brief=briefFormulas[entry.data.slug];
const schema = [blogPosting(Astro.url.pathname,entry.data.title,entry.data.description,{datePublished:entry.data.pubDate.toISOString(),dateModified:(entry.data.updatedDate??entry.data.pubDate).toISOString(),image:canonical(entry.data.image),author:{'@type':'Organization',name:entry.data.author,url:canonical('/editorial/')},isPartOf:{'@id':canonical('/')+'#webpage'}})];
---
<Base title={entry.data.seoTitle} titleIsComplete breadcrumbTitle={entry.data.title} description={entry.data.metaDescription} kind="article" image={entry.data.image} imageAlt={entry.data.imageAlt} schema={schema}><article class="shell page-intro"><p class="eyebrow">{entry.data.categories.join(' · ').replaceAll('-', ' ')}</p><h1 class="article-title">{entry.data.title}</h1><div class:list={{'quick-answer':!!brief}}>{brief&&<strong>Answer in brief</strong>}<p class="spoke-intro">{entry.data.description} Connect these concepts with the calculator and circuit overview in our <a href="/">AC to DC converter hub</a>.</p>{brief&&<code translate="no">{brief}</code>}</div><p class="byline">By <a href="/editorial/" rel="author">{entry.data.author}</a> · Published <time datetime={entry.data.pubDate.toISOString()}>{entry.data.pubDate.toLocaleDateString('en-GB', { timeZone: 'UTC', day: 'numeric', month: 'long', year: 'numeric' })}</time> · Last updated <time datetime={(entry.data.updatedDate??entry.data.pubDate).toISOString()}>{(entry.data.updatedDate??entry.data.pubDate).toLocaleDateString('en-GB', { timeZone: 'UTC', day: 'numeric', month: 'long', year: 'numeric' })}</time></p><img class="featured-image" src={entry.data.image} alt={entry.data.imageAlt} width="960" height="540" /><div class="article-layout"><nav class="toc" aria-label="Table of contents"><span class="eyebrow">IN THIS GUIDE</span><ol>{headings.filter(heading => heading.depth === 2).map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav><div class="prose"><AdSlot placement="article-top" /><Content /><AdSlot placement="article-bottom" /><div class="author-box"><h2>About the author</h2><p>{entry.data.author} is the editorial byline for this site's educational content. References are linked in each guide; no professional certification or independent expert review is claimed. <a href="/editorial/">Read our editorial profile and standards</a>.</p></div><ShareLinks path={Astro.url.pathname} title={entry.data.title}/><p>Filed under {entry.data.categories.map(category => <a href={`/category/${category}/`}>{category.replaceAll('-', ' ')} </a>)}</p><p class="tags">Topics: {entry.data.tags.join(' · ')}</p></div></div></article></Base>
