---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import {techArticle} from '../../lib/structured-data';
import { posts } from '../../lib/posts';
import { canonical } from '../../config/seo.config';
export async function getStaticPaths() { return (await posts()).map(entry => ({ params: { slug: entry.data.slug }, props: { entry } })); }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const schema = [techArticle(Astro.url.pathname,entry.data.title,entry.data.description,{datePublished:entry.data.pubDate.toISOString(),dateModified:(entry.data.updatedDate??entry.data.pubDate).toISOString(),image:canonical(entry.data.image),author:{'@type':'Organization',name:entry.data.author,url:canonical('/editorial/')},isPartOf:{'@id':canonical('/')+'#webpage'}})];
---
<Base title={entry.data.seoTitle} titleIsComplete breadcrumbTitle={entry.data.title} description={entry.data.metaDescription} kind="article" image={entry.data.image} imageAlt={entry.data.imageAlt} schema={schema}><article class="shell page-intro"><p class="eyebrow">{entry.data.categories.join(' · ').replaceAll('-', ' ')}</p><h1 class="article-title">{entry.data.title}</h1><p class="spoke-intro">{entry.data.description} Connect these concepts with the calculator and circuit overview in our <a href="/">AC to DC converter hub</a>.</p><p class="byline">By {entry.data.author} · <time datetime={entry.data.pubDate.toISOString()}>{entry.data.pubDate.toLocaleDateString('en-GB', { timeZone: 'UTC', day: 'numeric', month: 'long', year: 'numeric' })}</time>{entry.data.updatedDate && <> · Updated <time datetime={entry.data.updatedDate.toISOString()}>{entry.data.updatedDate.toLocaleDateString('en-GB', { timeZone: 'UTC' })}</time></>}</p><img class="featured-image" src={entry.data.image} alt={entry.data.imageAlt} width="960" height="540" /><div class="article-layout"><nav class="toc" aria-label="Table of contents"><span class="eyebrow">IN THIS GUIDE</span><ol>{headings.filter(heading => heading.depth === 2).map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav><div class="prose"><AdSlot placement="article-top" /><Content /><AdSlot placement="article-bottom" /><div class="author-box"><h2>About the author</h2><p>{entry.data.author} is the editorial byline for this site's educational content. References are linked in each guide; no professional certification or independent expert review is claimed. <a href="/editorial/">Read our editorial profile and standards</a>.</p></div><p>Filed under {entry.data.categories.map(category => <a href={`/category/${category}/`}>{category.replaceAll('-', ' ')} </a>)}</p><p class="tags">Topics: {entry.data.tags.join(' · ')}</p></div></div></article></Base>
