---
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import SiteSearchForm from '../components/SiteSearchForm.astro';
import { site } from '../config/site.config';
import { seo, canonical } from '../config/seo.config';
import AdSlot from '../components/AdSlot.astro';
import Analytics from '../components/Analytics.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedSpokes from '../components/RelatedSpokes.astro';
import {breadcrumbsForPath,breadcrumbSchema} from '../lib/breadcrumbs';
import {buildSpokes,isSpokeRoute,relatedSpokes} from '../lib/topic-graph';
import {posts} from '../lib/posts';
import {serializeJsonLd} from '../lib/structured-data';
import indexing from '../config/indexing.json';
interface Props { title: string; titleIsComplete?:boolean; breadcrumbTitle?:string; description: string; kind?: 'website' | 'article'; image?: string; imageAlt?: string; noindex?: boolean; schema?: Record<string, unknown>[]; }
const { title, titleIsComplete=false, breadcrumbTitle=title, description, kind = 'website', image = site.social.image, imageAlt = site.social.imageAlt, noindex = false, schema = [] } = Astro.props;
const url = canonical(Astro.url.pathname);
const pageNoindex=noindex||indexing.publicNoindexRoutes.includes(Astro.url.pathname);
const pageTitle = titleIsComplete ? title : `${title} | ${seo.titleSuffix}`;
const crumbs=breadcrumbsForPath(Astro.url.pathname,breadcrumbTitle);
const related=!pageNoindex&&isSpokeRoute(Astro.url.pathname)?relatedSpokes(Astro.url.pathname,buildSpokes(await posts())):[];
const structured = {'@context':'https://schema.org','@graph':[
  {'@type':'Organization','@id':canonical('/editorial/')+'#organization',name:site.name+' editorial',url:canonical('/editorial/'),logo:canonical(site.logo)},
  {'@type':'WebSite','@id':canonical('/')+'#website',name:site.name,url:canonical('/'),publisher:{'@id':canonical('/editorial/')+'#organization'}},
  {'@type':'SiteNavigationElement','@id':canonical('/')+'#navigation',name:site.nav.map(link=>link.label),url:site.nav.map(link=>canonical(link.href)),isPartOf:{'@id':canonical('/')+'#website'}},
  {'@type':'WebPage','@id':url+'#webpage',name:title,description,url,isPartOf:{'@id':canonical('/')+'#website'},...(crumbs.length?{breadcrumb:{'@id':url+'#breadcrumbs'}}:{})},
  ...(crumbs.length?[breadcrumbSchema(crumbs,Astro.url.pathname)]:[]),
  ...schema.map(node=>{const clean={...node};delete clean['@context'];return clean;}),
]};
---
<!doctype html>
<html lang={seo.language} style={`--brand:${site.colors.primary};--accent:${site.colors.accent}`}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title><meta name="description" content={description} />
    <link rel="canonical" href={url} /><link rel="icon" type={site.favicon.endsWith('.svg') ? 'image/svg+xml' : undefined} href={site.favicon} />
    <link rel="alternate" type="application/rss+xml" title="English technical guides RSS feed" href="/rss.xml" />
    <meta name="robots" content={!site.indexable || pageNoindex ? 'noindex, follow' : site.defaultRobots} />
    <meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} />
    <meta property="og:type" content={kind} /><meta property="og:url" content={url} />
    <meta property="og:site_name" content={site.name} /><meta property="og:locale" content={seo.locale} />
    <meta property="og:image" content={canonical(image)} /><meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} /><meta name="twitter:image" content={canonical(image)} /><meta name="twitter:image:alt" content={imageAlt} />
    {site.social.twitterHandle && <meta name="twitter:site" content={site.social.twitterHandle} />}
    <script type="application/ld+json" set:html={serializeJsonLd(structured)} />
  </head>
  <body id="top">
    <a class="skip" href="#main">Skip to content</a>
    <header class="header"><div class="shell header-inner">
      <a href="/" class="brand" aria-label={`${site.wordmark}. — ${site.name} home`}><img src={site.logo} alt="AC to DC Converter logo" width="32" height="32" />{site.wordmark}<span class="brand-dot">.</span></a>
      <nav aria-label="Main navigation">{site.nav.map(link => <a href={link.href} aria-current={Astro.url.pathname === link.href ? 'page' : undefined}>{link.label}</a>)}</nav>
      <span class="header-note"><span class="status-dot"></span> A little more clarity.</span>
    </div></header>
    <main id="main"><div class="shell"><AdSlot placement="header" /></div>{crumbs.length>0&&<div class="shell page-breadcrumbs"><Breadcrumbs items={crumbs}/></div>}<slot /><RelatedSpokes spokes={related}/><div class="shell"><AdSlot placement="footer" /></div></main>
    <footer><div class="shell"><div class="footer-top"><div><a class="brand" href="/">{site.wordmark}<span class="brand-dot">.</span></a><p>AC to DC Converter provides browser-based rectifier calculators and technical guides about voltage, ripple, filtering and regulation. Every model states its assumptions; worked examples and linked references help you interpret the result.</p><p><a href="https://github.com/actodcconverter1-ai/actodcconverter">Source code on GitHub</a> · <a href="/rss.xml">RSS feed (English)</a></p></div><nav class="footer-links" aria-label="Footer navigation"><a href="/about/">About us</a><a href="/authors/">Authors and team</a><a href="/editorial/">Editorial standards</a><a href="/contact/">Contact</a><a href="/blog/">Guides</a><a href="/sitemap/">HTML sitemap</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/disclaimer/">Disclaimer</a></nav></div><SiteSearchForm/><p class="external-link-notice">External references open in a new tab.</p><a href="#top" class="back-to-top">Back to top ↑</a><LanguageSwitcher/><div class="footer-bottom"><span>© {new Date().getFullYear()} {site.name}</span><span>Calculated in your browser. No account needed.</span></div></div></footer>
    {!noindex && <Analytics/>}
  </body>
</html>
